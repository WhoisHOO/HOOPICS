<!-- HOOPICS window. Text comes from strings.json, so this file stays ASCII. -->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HOOPICS" Width="600" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="White" AllowDrop="True"
        FontFamily="Segoe UI, Malgun Gothic" FontSize="13" Foreground="#1A1A1A"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#111111"/>
    <SolidColorBrush x:Key="Muted" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Line" Color="#D6D6D6"/>

    <Style x:Key="Step" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>

    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="15" Padding="14,6" Background="White"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#111111"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="#111111" Padding="16,11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Background" Value="#BDBDBD"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="White" BorderBrush="#111111"
                    BorderThickness="1" Padding="14,7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Link" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#6B6B6B"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="12" Padding="10,4" Background="Transparent"
                    BorderBrush="{StaticResource Line}" BorderThickness="1">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#111111"/>
                <Setter Property="Foreground" Value="#111111"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
  </Window.Resources>

  <StackPanel x:Name="Root" Margin="24,20,24,18">
    <DockPanel>
      <Image x:Name="Logo" Width="44" Height="44" Margin="0,0,14,0" DockPanel.Dock="Left"
             RenderOptions.BitmapScalingMode="HighQuality"/>
      <Button x:Name="LanguageButton" DockPanel.Dock="Right" Style="{StaticResource Link}" VerticalAlignment="Top"/>
      <StackPanel VerticalAlignment="Center">
        <TextBlock Text="HOOPICS" FontSize="21" FontWeight="Bold"/>
        <TextBlock x:Name="Subtitle" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </DockPanel>

    <Grid x:Name="DropZone" Margin="0,16,0,0" Height="150" Cursor="Hand" Background="#F7F7F7">
      <Rectangle x:Name="DropBorder" RadiusX="10" RadiusY="10" Stroke="#C2C2C2" StrokeThickness="1.5"
                 StrokeDashArray="5 3"/>
      <StackPanel x:Name="DropHint" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="#444444"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="DropTitle" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="DropSub" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                   HorizontalAlignment="Center"/>
      </StackPanel>
      <DockPanel x:Name="Preview" Margin="14" Visibility="Collapsed">
        <Image x:Name="Thumb" DockPanel.Dock="Left" MaxWidth="210" MaxHeight="122" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
          <TextBlock x:Name="FileName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="FileInfo" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
          <TextBlock x:Name="DropChange" Foreground="#9A9A9A" FontSize="12" Margin="0,10,0,0"/>
        </StackPanel>
      </DockPanel>
    </Grid>

    <TextBlock x:Name="StepDevice" Style="{StaticResource Step}"/>
    <WrapPanel x:Name="Categories">
      <RadioButton x:Name="CatScreen" Tag="screen" GroupName="category" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="CatLaptop" Tag="laptop" GroupName="category" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="CatMonitor" Tag="monitor" GroupName="category" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="CatPhone" Tag="phone" GroupName="category" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="CatScale" Tag="scale" GroupName="category" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="CatCustom" Tag="custom" GroupName="category" Style="{StaticResource Chip}"/>
    </WrapPanel>

    <TextBlock x:Name="StepResolution" Style="{StaticResource Step}" Margin="0,8,0,8"/>
    <ComboBox x:Name="ResolutionBox"/>
    <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Visibility="Collapsed">
      <TextBox x:Name="CustomWidth" Width="96"/>
      <TextBlock Text="&#215;" Margin="10,0" VerticalAlignment="Center"/>
      <TextBox x:Name="CustomHeight" Width="96"/>
      <TextBlock Text="px" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
    </StackPanel>

    <TextBlock x:Name="StepModel" Style="{StaticResource Step}"/>
    <ComboBox x:Name="ModelBox"/>

    <TextBlock x:Name="StepMode" Style="{StaticResource Step}"/>
    <WrapPanel>
      <RadioButton x:Name="ModeFill" GroupName="mode" IsChecked="True" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="ModeFit" GroupName="mode" Style="{StaticResource Chip}"/>
    </WrapPanel>

    <WrapPanel Margin="0,6,0,0">
      <TextBlock x:Name="FormatLabel" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,8"/>
      <RadioButton x:Name="FormatPng" GroupName="format" IsChecked="True" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FormatJpg" GroupName="format" Style="{StaticResource Chip}"/>
    </WrapPanel>

    <CheckBox x:Name="SetWallpaper" Margin="0,6,0,0" VerticalContentAlignment="Center"/>

    <TextBlock x:Name="Summary" Margin="0,16,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
    <Button x:Name="StartButton" Style="{StaticResource Primary}" Margin="0,10,0,0"/>
    <ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,0" Visibility="Collapsed" Maximum="100"
                 Foreground="#111111" Background="#E4E4E4" BorderThickness="0"/>
    <TextBlock x:Name="Status" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Button x:Name="OpenFolder" Style="{StaticResource Secondary}" HorizontalAlignment="Left"
            Margin="0,8,0,0" Visibility="Collapsed"/>
    <TextBlock x:Name="Footer" FontSize="11" Foreground="#7A7A7A" Margin="0,18,0,0" TextWrapping="Wrap"/>
  </StackPanel>
</Window>
